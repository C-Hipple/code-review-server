{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "resolveJsonModule": true,
        "composite": true,
        "noEmit": false
    },
    "include": ["vite.config.js"]
}
